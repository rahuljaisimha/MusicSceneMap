{
  "name": "music-scene-map",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "upload-graph": "npx wrangler r2 object put musicscenemap-graph/graph.db.gz --file public/graph.db.gz --content-type application/gzip --remote",
    "regen-graph": "python3 scripts/process_mb_dump.py && npm run upload-graph"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-router-dom": "^7.18.2",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
